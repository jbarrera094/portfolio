---
import ExternalLink from "./icons/ExternalLink.astro";

export interface Props {
  company: string;
  date: string;
  title: string;
  description: string;
  link?: string;
}
const { company, date, title, description, link } = Astro.props;
---

<div
  class="absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900 dark:bg-gray-700"
>
</div>
<div class="mb-10 ms-4 flex flex-col md:flex-row">
  <section
    class="flex flex-col md:min-w-[35%] md:max-w-[35%] md:me-6 mb-4 md:mb-0"
  >
    <h3 class="text-xl font-semibold text-sky-500 text-pretty">
      {title}
    </h3>
    <div class="flex items-center gap-2">
      <span class="text-lg font-light">{company}</span>

      {
        link && (
          <a href={link} target="_blank" rel="noopener noreferrer">
            <ExternalLink class="size-4" />
          </a>
        )
      }
    </div>
    <time class="text-sm
      font-light
      leading-none
      text-gray-400">
      {date}
    </time>
  </section>
  <section class="flex flex-col">
    <p class="mb-4 text-base font-light text-gray-400">
      {description}
    </p>
  </section>
</div>
